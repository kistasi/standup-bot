ANTHROPIC_API_KEY=
AUTHOR_EMAILS=
GH_PAT=
GH_ORG=
# Optional: when set, the summary is posted to this Slack incoming webhook.
SLACK_WEBHOOK_URL=
# Optional: switches tracked time into the digest. Your Toggl Track API token
# (Toggl profile page) — the token is the whole configuration. Note the API
# serves only ~3 months of history, so an older monthly report is written
# without its hours.
TOGGL_API_TOKEN=
# Optional: the credential shared by the two Google features below. A Google
# credentials JSON on one line — typically authorized-user creds from
# `gcloud auth application-default login --scopes=openid,\
# https://www.googleapis.com/auth/calendar.readonly,\
# https://www.googleapis.com/auth/drive.file` (list only the scopes you need;
# one login grants them all at once), or a service-account key. Setting it
# without switching on at least one of the two features below is an error.
GOOGLE_CREDENTIALS_JSON=
# Optional: switches Google Calendar events into the summary. The calendar to
# read (your email, or "primary"). Needs GOOGLE_CREDENTIALS_JSON.
GOOGLE_CALENDAR_ID=
# Optional: switches on the Google Drive backup of finished reports. The name
# of the My Drive folder to upload to (e.g. "standup-bot") — a name, not an ID,
# because the drive.file scope only sees files this bot created, so the bot
# creates the folder itself on first run. Needs GOOGLE_CREDENTIALS_JSON with
# the drive.file scope.
GOOGLE_DRIVE_FOLDER=
