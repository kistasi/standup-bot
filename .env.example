# Required
GITHUB_PAT=

# Required only when STANDUP_SUMMARIZE is on
ANTHROPIC_API_KEY=

# Optional — comma-separated git emails to attribute commits to.
# Falls back to `git config user.email` when unset.
AUTHOR_EMAILS=

# Optional — override the project the digest is built from.
# Defaults: DPGAlliance / 14 / 24h.
STANDUP_ORG=
STANDUP_PROJECT=
STANDUP_LOOKBACK=

# Optional — set truthy (1/true/yes) to summarize the digest with Claude
# instead of printing it raw.
STANDUP_SUMMARIZE=
