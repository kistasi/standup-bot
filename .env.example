ANTHROPIC_API_KEY=
AUTHOR_EMAILS=
GH_PAT=
GH_ORG=
GH_PROJECT=
# Optional: when set, the summary is posted to this Slack incoming webhook.
SLACK_WEBHOOK_URL=
# Optional: set both to include Google Calendar events in the summary.
# GOOGLE_CREDENTIALS_JSON is a Google credentials JSON on one line — typically
# authorized-user creds from `gcloud auth application-default login
# --scopes=openid,https://www.googleapis.com/auth/calendar.readonly` (reads your
# own calendar with full details), or a service-account key. GOOGLE_CALENDAR_ID
# is the calendar to read (your email, or "primary").
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=
